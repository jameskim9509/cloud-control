AWS_PROFILE=lab
AWS_REGION=ap-northeast-2
EXPECTED_ACCOUNT_ID=123456789012
# 앱 접속 토큰(필수). 생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
# 시작·중지를 허용할 EC2 인스턴스 ID, 쉼표로 구분. 비우면 조회만 가능.
ALLOWED_INSTANCE_IDS=
# 이력 DB (MariaDB). 실제 암호는 .env에만 넣는다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cloudapp
DB_PASSWORD=
DB_NAME=clouddb
